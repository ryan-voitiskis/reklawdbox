{
  "name": "reklawdbox-discogs-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler d1 migrations apply DB --local && wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.1",
    "@cloudflare/workers-types": "^4.20260227.0",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^11.5.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.67.0"
  }
}
