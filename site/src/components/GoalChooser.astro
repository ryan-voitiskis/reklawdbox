---
import { compactSafety } from '../data/workflow-presentation.mjs'
import { goalDefinitions, workflows } from '../data/workflows.mjs'

const groups = goalDefinitions.map((goal) => ({
  ...goal,
  workflows: workflows
    .filter((workflow) => workflow.goals.includes(goal.id))
    .map((workflow) => ({
      ...workflow,
      safety: compactSafety(workflow),
    })),
}))

if (groups.some((goal) => goal.workflows.length === 0)) {
  throw new Error('Every onboarding goal must resolve at least one workflow')
}
---

<div class="goal-chooser" data-onboarding-goals>
  <div class="goal-grid">
    {groups.map((goal) => goal.workflows.length === 1 ? (
      <article
        class="direct-choice"
        data-goal-choice
        data-goal-type="direct"
        data-workflow-choice
      >
        <h3>{goal.title}</h3>

        <div class="choice-actions">
          <p class:list={['safety-line', `safety-${goal.workflows[0].safety.tone}`]}>
            {goal.workflows[0].safety.label}
          </p>

          <a
            class="workflow-link"
            href={goal.workflows[0].route}
            aria-label={`Start ${goal.workflows[0].title}`}
          >
            Start <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ) : (
      <details class="goal-options" data-goal-choice data-goal-type="disclosure">
        <summary>
          <span class="summary-content">
            <strong class="goal-title">{goal.title}</strong>
            <span class="option-count">{goal.workflows.length} choices</span>
          </span>
        </summary>

        <ul class="workflow-options">
          {goal.workflows.map((workflow) => (
            <li>
              <article class="workflow-choice" data-workflow-choice>
                <div class="choice-copy">
                  <h3>{workflow.title}</h3>
                  <p>{workflow.chooseWhen}</p>
                </div>

                <p class:list={['safety-line', `safety-${workflow.safety.tone}`]}>
                  {workflow.safety.label}
                </p>

                <a
                  class="workflow-link"
                  href={workflow.route}
                  aria-label={`Open ${workflow.title}`}
                >
                  Open <span aria-hidden="true">→</span>
                </a>
              </article>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>

  <nav class="reference-links" aria-label="More ways to explore">
    <a class="browse-link" href="/workflows/">
      All workflows <span aria-hidden="true">→</span>
    </a>
    <a class="reference-link" href="/concepts/">
      How it works <span aria-hidden="true">→</span>
    </a>
  </nav>
</div>

<style>
  .goal-chooser {
    display: grid;
    gap: 1.25rem;
    margin-block: 1.5rem;
  }

  .goal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    align-items: start;
    gap: 0.9rem;
  }

  .direct-choice,
  .goal-options {
    min-width: 0;
    overflow-wrap: anywhere;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-black);
  }

  .direct-choice {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1rem, 3vw, 1.2rem);
  }

  .choice-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
  }

  .direct-choice h3,
  .choice-copy p,
  .safety-line {
    margin: 0;
  }

  .direct-choice h3,
  .choice-copy h3 {
    font-size: var(--sl-text-lg);
  }

  .choice-copy p {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .goal-options summary {
    display: list-item;
    padding: clamp(1rem, 3vw, 1.2rem);
    cursor: pointer;
  }

  .summary-content {
    display: inline-flex;
    width: calc(100% - 0.75rem);
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem 1rem;
    vertical-align: middle;
  }

  .goal-options summary::marker {
    color: var(--sl-color-accent-high);
  }

  .goal-options summary:focus-visible,
  .workflow-link:focus-visible,
  .reference-links a:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .goal-title {
    min-width: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
  }

  .option-count {
    flex: none;
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-sm);
    font-weight: 700;
  }

  .workflow-options {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--sl-color-gray-5);
    list-style: none;
  }

  .workflow-options > li + li {
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .workflow-choice {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1rem, 3vw, 1.2rem);
  }

  .safety-line {
    width: fit-content;
    max-width: 100%;
    padding: 0.35rem 0.55rem;
    border-left: 3px solid;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-xs);
    font-weight: 650;
  }

  .safety-safe {
    border-color: var(--sl-color-green-high);
  }

  .safety-review {
    border-color: var(--sl-color-orange-high);
  }

  .safety-write {
    border-color: var(--sl-color-red-high);
  }

  .workflow-link,
  .browse-link {
    width: fit-content;
    color: var(--sl-color-accent-high);
    font-weight: 700;
  }

  .reference-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .reference-link {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
