---
import { compactSafety } from '../data/workflow-presentation.mjs'
import { goalDefinitions, workflows } from '../data/workflows.mjs'

const groups = goalDefinitions.map((goal) => ({
  ...goal,
  workflows: workflows
    .filter((workflow) => workflow.goals.includes(goal.id))
    .map((workflow) => ({
      ...workflow,
      safety: compactSafety(workflow),
    })),
}))

if (groups.some((goal) => goal.workflows.length === 0)) {
  throw new Error('Every workflow catalog goal must resolve at least one workflow')
}
---

<div class="workflow-catalog" data-workflow-catalog>
  {groups.map((goal) => (
    <section class="goal-group" data-goal-group={goal.id}>
      <header class="goal-header">
        <h2>{goal.title}</h2>
        <p>{goal.summary}</p>
      </header>

      <ul class:list={['workflow-list', goal.workflows.length === 1 && 'workflow-list--single']}>
        {goal.workflows.map((workflow) => (
          <li>
            <article class="workflow-card" data-workflow-choice={workflow.id}>
              <div class="workflow-copy">
                <h3>{workflow.title}</h3>
                <p>{workflow.chooseWhen}</p>
              </div>

              <p
                class:list={['safety-line', `safety-${workflow.safety.tone}`]}
                data-compact-safety={workflow.safety.tone}
              >
                {workflow.safety.label}
              </p>

              <p class="time-line"><strong>Time:</strong> {workflow.duration}</p>

              <a class="workflow-link" href={workflow.route}>
                Open {workflow.title} <span aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .workflow-catalog {
    display: grid;
    gap: 2rem;
    margin-block: 1.5rem 2rem;
  }

  .goal-group,
  .goal-header,
  .workflow-card,
  .workflow-copy {
    display: grid;
  }

  .goal-group {
    gap: 0.85rem;
  }

  .goal-header {
    gap: 0.25rem;
    max-width: 48rem;
  }

  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  .goal-header h2 {
    font-size: var(--sl-text-2xl);
  }

  .goal-header p,
  .workflow-copy p,
  .time-line {
    color: var(--sl-color-gray-2);
  }

  .workflow-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .workflow-list--single {
    grid-template-columns: minmax(0, 38rem);
  }

  .workflow-list > li {
    min-width: 0;
  }

  .workflow-card {
    min-height: 100%;
    align-content: start;
    gap: 0.8rem;
    padding: clamp(0.9rem, 3vw, 1.15rem);
    overflow-wrap: anywhere;
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    background: var(--card-bg);
  }

  .workflow-copy {
    gap: 0.3rem;
  }

  .workflow-copy h3 {
    font-size: var(--sl-text-lg);
  }

  .workflow-copy p,
  .time-line,
  .safety-line {
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }

  .safety-line {
    width: fit-content;
    max-width: 100%;
    padding: 0.35rem 0.55rem;
    border-left: 3px solid;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font-weight: 650;
  }

  .safety-safe {
    border-color: var(--sl-color-green-high);
  }

  .safety-review {
    border-color: var(--sl-color-orange-high);
  }

  .safety-write {
    border-color: var(--sl-color-red-high);
  }

  .workflow-link {
    width: fit-content;
    margin-top: auto;
    color: var(--sl-color-accent-high);
    font-weight: 700;
  }

  .workflow-link:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }
</style>
