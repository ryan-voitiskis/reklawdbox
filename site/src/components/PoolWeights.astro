---
// Side-by-side comparison of pool kernel weight presets and transition scorer weights
// Uses stacked horizontal bars like PriorityWeights.astro

interface Axis {
  name: string;
  color: string;
}

const axes: Axis[] = [
  { name: 'BPM',        color: '#22c55e' },
  { name: 'Energy',     color: '#f97316' },
  { name: 'Timbral',    color: '#a855f7' },
  { name: 'Key',        color: '#3b82f6' },
  { name: 'Genre',      color: '#8b5cf6' },
  { name: 'Brightness', color: '#06b6d4' },
  { name: 'Rhythm',     color: '#ec4899' },
];

interface Preset {
  name: string;
  group: string;
  weights: number[];
}

const presets: Preset[] = [
  { name: 'Balanced', group: 'Pool',       weights: [0.25, 0.20, 0.18, 0.12, 0.10, 0.08, 0.07] },
  { name: 'Timbral',  group: 'Pool',       weights: [0.20, 0.15, 0.35, 0.10, 0.05, 0.08, 0.07] },
  { name: 'Balanced', group: 'Transition', weights: [0.20, 0.18, 0.00, 0.30, 0.17, 0.08, 0.07] },
];
---

<figure class="pool-weights">
  <div class="chart">
    {presets.map(p => (
      <div class="row">
        <span class="preset-label">
          <span class="preset-group">{p.group}</span>
          <span class="preset-name">{p.name}</span>
        </span>
        <div class="bar-track">
          {p.weights.map((w, i) => (
            w > 0 && (
              <div
                class="bar-segment"
                style={`width: ${w * 100}%; background: ${axes[i].color};`}
                title={`${axes[i].name}: ${Math.round(w * 100)}%`}
              >
                {w >= 0.10 && <span class="seg-label">{Math.round(w * 100)}%</span>}
              </div>
            )
          ))}
        </div>
      </div>
    ))}
  </div>

  <figcaption class="weight-legend">
    {axes.map(a => (
      <span class="legend-item">
        <span class="dot" style={`background: ${a.color}`}></span>
        {a.name}
      </span>
    ))}
  </figcaption>
</figure>

<style>
  .pool-weights {
    max-width: 560px;
    margin: 1.5rem auto;
  }
  .chart {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .preset-label {
    width: 7rem;
    text-align: right;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }
  .preset-group {
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--sl-color-text);
    opacity: 0.55;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .preset-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }
  .bar-track {
    flex: 1;
    display: flex;
    height: 26px;
    border-radius: 4px;
    overflow: hidden;
  }
  .bar-segment {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    transition: opacity 0.15s;
  }
  .bar-segment:hover {
    opacity: 0.85;
  }
  .seg-label {
    font-family: var(--sl-font-mono);
    font-size: 10px;
    font-weight: 150;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
    white-space: nowrap;
  }
  .weight-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.78rem;
    color: var(--sl-color-text);
    opacity: 0.85;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
</style>
